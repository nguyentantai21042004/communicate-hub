#!/bin/sh
# serve: run the patched telegram-mcp as one long-lived HTTP server (one Telegram session).
# Secrets live in ~/.config/telegram-captain/env (chmod 600), never in this folder:
#   TELEGRAM_API_ID=...  TELEGRAM_API_HASH=...  TELEGRAM_SESSION_STRING=...
#   TELEGRAM_ALLOWED_CHAT_IDS=@hai,@lan,123456   # hard bound on what the agent may read/draft to
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
ENV_FILE=${CAPTAIN_ENV_FILE:-$HOME/.config/telegram-captain/env}
[ -f "$ENV_FILE" ] || { echo "missing $ENV_FILE (see README, step 2)" >&2; exit 1; }
set -a; . "$ENV_FILE"; set +a

export MCP_TRANSPORT=http MCP_HOST=127.0.0.1 MCP_PORT=8765
export TELEGRAM_EVENT_FEED=1                          # write settled DM bursts to the feed
export TELEGRAM_EXPOSED_TOOLS="${TELEGRAM_EXPOSED_TOOLS:-read-only+save_draft}"  # no send tool exists
export TELEGRAM_DEVICE_MODEL="${TELEGRAM_DEVICE_MODEL:-Captain drafts (MacBook 2)}"
export TELEGRAM_SYSTEM_VERSION=macOS TELEGRAM_APP_VERSION=0.1

if lsof -nP -iTCP:8765 -sTCP:LISTEN >/dev/null 2>&1; then
  echo "port 8765 already has a listener; not starting a second session" >&2; exit 1
fi
cd "$ROOT/../../../refs/chigwell__telegram-mcp"
exec uv run main.py
