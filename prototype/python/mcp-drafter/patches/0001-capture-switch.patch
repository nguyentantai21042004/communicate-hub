+# --- Capture switch (runtime on/off + thread selection) ---
+# A small JSON file the operator edits while the server runs:
+#   {"enabled": true, "chats": ["@alice", 123456789]}
+# Missing file keeps the old behaviour (capture every allowed private chat).
+# "chats" empty or absent means every allowed chat. It narrows capture only;
+# TELEGRAM_ALLOWED_CHAT_IDS still bounds what the agent can read or draft to.
+_CAPTURE_FILE_ENV = "TELEGRAM_CAPTURE_FILE"
+_capture_cache: Tuple[Optional[float], Tuple[bool, Optional[set]]] = (None, (True, None))
+
+
+def capture_file_path() -> Path:
+    override = os.getenv(_CAPTURE_FILE_ENV)
+    return Path(override) if override else _default_feed_file().with_name("capture.json")
+
+
+def _load_capture_rules() -> Tuple[bool, Optional[set]]:
+    """Return (enabled, chat set or None for all), re-reading the file only when it changes."""
+    global _capture_cache
+    path = capture_file_path()
+    try:
+        mtime = path.stat().st_mtime
+    except FileNotFoundError:
+        _capture_cache = (None, (True, None))
+        return _capture_cache[1]
+    if _capture_cache[0] == mtime:
+        return _capture_cache[1]
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+        rules = (bool(data.get("enabled", True)), _parse_allowed_chat_ids(data.get("chats") or []))
+    except (OSError, ValueError, AttributeError):
+        # Fail closed: a half-written or hand-broken file must not open capture to every chat.
+        logging.getLogger("telegram_mcp").error("Invalid capture file; capture paused")
+        rules = (False, None)
+    _capture_cache = (mtime, rules)
+    return rules
+
+
+def is_capture_wanted(chat_id: int, sender: Any = None) -> bool:
+    enabled, chats = _load_capture_rules()
+    if not enabled:
+        return False
+    return chats is None or chat_in_set(chats, chat_id, sender)
+
+
 def feed_enabled() -> bool:
     return _feed_task is not None and not _feed_task.done()
 
